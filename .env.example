# Shared
SCION_ENV=development

# API
SCION_API_HOST=0.0.0.0
SCION_API_PORT=8000
SCION_API_PREFIX=/api
SCION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
SCION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scion
SCION_LOG_LEVEL=INFO
SCION_SLOW_OPERATION_MS=250
SCION_EXPORT_MAX_ROWS=500
SCION_BUSY_RETRY_AFTER_SECONDS=5
SCION_EXPORT_SLOT_LIMIT=1
SCION_ANALYTICS_SLOT_LIMIT=4
SCION_SKIP_STARTUP_CHECKS=false

# Account auth
SCION_AUTH_COOKIE_NAME=cell_anatomy_session
SCION_AUTH_CODE_TTL_MINUTES=10
SCION_AUTH_SESSION_DAYS=30
SCION_AUTH_REMEMBER_DAYS=90
SCION_AUTH_DEVICE_DAYS=180
SCION_AUTH_DEVICE_PAIRING_TTL_MINUTES=10
SCION_AUTH_DEVICE_PAIRING_POLL_INTERVAL_SECONDS=3
SCION_AUTH_CODE_RATE_LIMIT_PER_HOUR=5
SCION_AUTH_COOKIE_SECURE=false
SCION_AUTH_EMAIL_FROM="Cell Anatomy <no-reply@cell-anatomy.local>"
SCION_AUTH_DEV_OUTBOX_PATH=.run/auth-codes.log

# Optional SMTP delivery for login codes. If unset, codes are written to SCION_AUTH_DEV_OUTBOX_PATH.
# SCION_AUTH_SMTP_HOST=smtp.example.com
# SCION_AUTH_SMTP_PORT=587
# SCION_AUTH_SMTP_USERNAME=
# SCION_AUTH_SMTP_PASSWORD=
# SCION_AUTH_SMTP_STARTTLS=true

# Web
SCION_WEB_HOST=127.0.0.1
SCION_WEB_PORT=3000
SCION_API_BASE_URL=http://127.0.0.1:8000/api
SCION_API_TIMEOUT_MS=5000
NEXT_PUBLIC_SCION_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_SCION_API_TIMEOUT_MS=5000

# Workbench
VITE_SCION_API_BASE_URL=http://127.0.0.1:8000/api
VITE_SCION_ATLAS_BASE_URL=http://127.0.0.1:3000
CELL_ANATOMY_VOLUME_ENGINE_PORT=8080
# CELL_ANATOMY_PUBLIC_DATA_ROOT=/path/to/public-data
